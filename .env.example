# ============================================================================
# BEM ME QUERO · MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ============================================================================

# --- Identidade e Ambiente ---
APP_NAME="Bem Me Quero - Estoque"
EMPRESA_NOME="Bem Me Quero Perfumaria"
EMPRESA_SLOGAN="Seu momento de amor-próprio"
FUSO_HORARIO="America/Fortaleza"
MOEDA_PADRAO="BRL"
DEBUG=false
LOG_LEVEL=INFO

# --- Segurança e Sessão ---
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-por-uma-chave-secreta-longa-com-pelo-menos-32-caracteres"
SESSION_MAX_AGE_SECONDS=28800

# --- Banco de Dados (SQLite local ou Supabase PostgreSQL) ---
# Exemplo Supabase:
# DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL="sqlite:///./bemmequero.db"
AUTO_CREATE_TABLES=true

# --- Limites de Segurança e Upload ---
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=300
UPLOAD_MAX_FOTO_MB=2
UPLOAD_MAX_IMPORTACAO_MB=10

# --- Parâmetros de Negócio e Estoque ---
ESTOQUE_MINIMO_PADRAO=3
VALIDADE_PADRAO_DIAS=730
ALERTA_VENCIMENTO_DIAS=30
MARGEM_LUCRO_PADRAO=1.35

# --- Contas Iniciais (criadas automaticamente caso o banco suba vazio) ---
SEED_USUARIOS_INICIAIS=true
ADMIN_INICIAL_EMAIL="admin@bemmequero.local"
ESTOQUE_INICIAL_EMAIL="estoque@bemmequero.local"
VENDAS_INICIAL_EMAIL="vendas@bemmequero.local"
SENHA_INICIAL_PADRAO="BemMeQuero2026"
